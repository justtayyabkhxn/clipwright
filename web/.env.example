# Clipwright configuration. Copy to web/.env.local and fill in the values.
# Both the Next app and the worker (pnpm dev / pnpm worker) read web/.env.local.
# Blank values count as unset.

# --- Required ---

# MongoDB connection string. Atlas (a replica set) is recommended.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name.
MONGODB_DB=clipwright
# Better Auth wraps sign-up and similar writes in transactions, which need a replica set (Atlas is one).
# Set false for a standalone local mongod.
MONGODB_TRANSACTIONS=true

# Session signing secret, at least 32 characters (e.g. `openssl rand -base64 48`).
# Also encrypts keys saved in Settings unless APP_SETTINGS_ENCRYPTION_KEY is set.
BETTER_AUTH_SECRET=<at-least-32-random-characters>
# Public base URL of the app.
BETTER_AUTH_URL=http://localhost:3000
# Extra comma-separated origins allowed to call the auth API.
BETTER_AUTH_TRUSTED_ORIGINS=

# --- Accounts ---

# The first account to sign up becomes an admin. These comma-separated emails are made admins at sign-up too.
ADMIN_EMAILS=
# true stops new sign-ups.
DISABLE_SIGN_UP=false
# Key for the settings saved in MongoDB (at least 16 characters). Falls back to BETTER_AUTH_SECRET.
# Changing it makes previously saved keys unreadable; save them again in Settings.
APP_SETTINGS_ENCRYPTION_KEY=

# --- AI and transcription ---
# These can be set here or saved by an admin in Settings. A value set here wins unless the admin
# ticks "use the saved values instead".

# Anthropic API key (https://console.anthropic.com/settings/keys). Usage is billed by Anthropic.
ANTHROPIC_API_KEY=
# AssemblyAI API key for transcription.
ASSEMBLY_AI_API_KEY=
# AssemblyAI API host. Empty uses https://api.assemblyai.com; set https://api.eu.assemblyai.com for the EU region.
ASSEMBLYAI_BASE_URL=
# Claude model ID for clip selection (default claude-opus-5).
CLAUDE_MODEL=
# Model for the long-video rerank pass (default: CLAUDE_MODEL).
CLAUDE_RERANK_MODEL=

# --- Storage and the render engine ---

# Durable files (storage/) and job temp dirs (work/). Default <repo>/data. Keep it short and ASCII on Windows.
DATA_DIR=
# Only "local" is implemented.
STORAGE_DRIVER=local
# Python render engine directory. Default <repo>/engine.
ENGINE_DIR=
# Interpreter for the engine. Default engine/.venv/Scripts/python.exe on Windows, engine/.venv/bin/python elsewhere.
# A relative path is resolved against the repo root.
ENGINE_PYTHON=
# Jobs the worker runs at once.
WORKER_CONCURRENCY=1

# --- Limits and processing ---

# Longest source video, in seconds.
MAX_VIDEO_DURATION=5400
# Largest upload, in bytes. NEXT_PUBLIC_MAX_VIDEO_UPLOAD_BYTES tells the browser the same limit.
MAX_VIDEO_UPLOAD_BYTES=4000000000
NEXT_PUBLIC_MAX_VIDEO_UPLOAD_BYTES=4000000000
# Most clips per video.
MAX_CLIPS=10
# Fallback clip length in seconds when the AI returns no usable segment.
CLIP_DURATION=30
# Spoken language code for transcription (e.g. es, de, en_us). Empty or "auto" detects it.
TRANSCRIPTION_LANGUAGE=
# How long to wait for an AssemblyAI transcript, in seconds.
ASSEMBLY_AI_HTTP_TIMEOUT_SECONDS=900
# Cut between speakers on multi-person wide shots, using diarization.
SPEAKER_FRAMING=true
# Replay a later punchline as a teaser before each clip.
HOOK_FIRST_TEASER=false
# Highest YouTube download resolution.
YOUTUBE_MAX_HEIGHT=1080

# --- Browser (inlined at build time) ---

# "Source" link in the sidebar and sign-in pages. AGPL-3.0: if you deploy a modified version,
# point this at the published source of your fork.
NEXT_PUBLIC_SOURCE_CODE_URL=
# Public origin used for page metadata (default http://localhost:3000).
NEXT_PUBLIC_APP_URL=
